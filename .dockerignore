# Keep secrets, local state, and bloat out of the build context / image.
.git
.gitignore
infra/terraform/.terraform/
infra/terraform/*.tfstate*

# Secrets — never bake into an image
.env
keys/
*.pem
*.key

# Local state (lives on volumes at runtime, not in the image)
memory/*.md
memory/*.json
!memory/.gitkeep
!memory/README.md
config/scheduler_state.json
config/ambient_state.json

# Logs & debug dumps
*.log
log.txt
debug/prompts/

# Python cruft
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
node_modules/
.venv/
venv/

# Media does not belong in the runtime image. Operational markdown is retained
# because the storage entrypoint seeds config, jobs, state, and knowledge defaults.
img/
ext_images_provided/
