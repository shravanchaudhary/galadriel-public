# Keep secrets, local state, and bloat out of the build context / image.
.git
.gitignore
infra/terraform/.terraform/
infra/terraform/*.tfstate*

# Secrets — never bake into an image
.env
keys/
*.pem
*.key

# Local state (lives on volumes at runtime, not in the image)
memory/*.md
memory/*.json
!memory/README.md
config/scheduler_state.json
config/ambient_state.json

# Logs & debug dumps
*.log
log.txt
debug/prompts/

# Python cruft
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
node_modules/
.venv/
venv/

# Media does not belong in the runtime image. Operational markdown is retained
# because the storage entrypoint seeds config, jobs, state, and knowledge defaults.
img/
ext_images_provided/

# Local LLM experiments / host-downloaded weights. The image downloads the
# staging GGUF in a dedicated layer (see Dockerfile) instead of copying these.
local_llm/models/*.gguf
local_llm/models/*.partial
local_llm/experimental_gemma1b.ipynb
local_llm/experimental_gemma270m.ipynb
.ipynb_checkpoints/

# Offline benchmark suite — never runtime code, and eval/models/ can hold GBs
# of downloaded GGUFs that must not enter the build context.
eval/
