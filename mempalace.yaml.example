# mempalace.yaml — room structure for the memory palace
#
# Copy to mempalace.yaml (without the .example suffix) and edit if needed.
#
# Lived memory uses a single wing (`agent`) with purpose-specific rooms.
# Do NOT mine the whole repo into the palace — that produced an obsolete
# code wing. Seed conversations / knowledge / episodes / diary via the
# harness archival tools and palace_add_drawer instead.
#
# How to initialize:
#
#   1. cp mempalace.yaml.example mempalace.yaml
#   2. pip install -r requirements.txt
#   3. mempalace init    # creates ~/.mempalace/ and reads this yaml
#
# See https://github.com/MemPalace/mempalace for the full schema.

wing: agent

rooms:
  - name: conversations   # verbatim chat archives only
    path: conversations
  - name: knowledge       # durable reusable / personal learned facts
    path: knowledge
  - name: episodes        # daily recaps and operational narratives
    path: episodes
  - name: diary           # first-person reflection
    path: diary
