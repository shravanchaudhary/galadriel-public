# Copy to staging.tfvars outside the repository and replace every placeholder.
# Values here identify existing shared staging infrastructure; Terraform creates
# only Clyra-owned resources.
vpc_id                = "vpc-..."
private_subnet_ids    = ["subnet-private-az1", "subnet-private-az2"]
alb_security_group_id = "sg-staging-alb"
documentdb_security_group_id = "sg-documentdb"
valkey_security_group_id     = "sg-valkey"
capacity_provider_name = "existing-staging-capacity-provider"
listener_rule_priority = 123
github_connection_arn  = "arn:aws:codestar-connections:ap-south-1:ACCOUNT:connection/..."

# Optional existing Secrets Manager ARNs, never secret values. The staging
# AppConfig profile is the standard runtime configuration source.
secret_arns = {
  # EXTRA_SECRET = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:clyra/extra"
}

environment = {
  AWS_REGION           = "ap-south-1"
  APPCONFIG_REQUIRED   = "true"
  TOWER_AUTH_REQUIRED  = "true"
  TOWER_AUTH_USERNAME  = "clyra"
  GALADRIEL_WORKER     = "1"
  GALADRIEL_REFLECTION = "1"
}
