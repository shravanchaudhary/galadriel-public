# Copy to staging.tfvars outside the repository and replace every placeholder.
# Values here identify existing shared staging infrastructure; Terraform creates
# only Clyra-owned resources.
vpc_id                = "vpc-..."
private_subnet_ids    = ["subnet-private-az1", "subnet-private-az2"]
alb_security_group_id = "sg-staging-alb"
documentdb_security_group_id = "sg-documentdb"
valkey_security_group_id     = "sg-valkey"
listener_rule_priority = 123
github_connection_arn  = "arn:aws:codestar-connections:ap-south-1:ACCOUNT:connection/..."
palace_backend         = "documentdb"
candidate_image_uri    = "ACCOUNT.dkr.ecr.REGION.amazonaws.com/stag-clyra@sha256:DIGEST"
host_name               = "app.replika.example.com"
replika_product_domain  = "replika.example.com"
replika_route53_zone_id = "Z..."
enable_replika_managed_auth = true
replika_control_plane_only  = true
replika_callback_token_secret_arn = "arn:aws:secretsmanager:REGION:ACCOUNT:secret:replika/provisioner-callback"
replika_runtime_secret_names = [
  "AGENTSOURCE_API_KEY",
  "AWS_BEARER_TOKEN_BEDROCK",
  "BCE_API_KEY",
  "FULLENRICH_API_KEY",
  "GEMINI_API_KEY",
  "SERPER_API_KEY",
  "TOWER_SECRET_KEY",
  "TRAFILATURA_API_KEY",
]
replika_runtime_provider_secret_arns = {
  AGENTSOURCE_API_KEY      = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/runtime/agentsource-api-key"
  AWS_BEARER_TOKEN_BEDROCK = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/runtime/bedrock-bearer-token"
  BCE_API_KEY              = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/runtime/bce-api-key"
  FULLENRICH_API_KEY  = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/runtime/fullenrich-api-key"
  GEMINI_API_KEY      = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/runtime/gemini-api-key"
  SERPER_API_KEY      = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/runtime/serper-api-key"
  TRAFILATURA_API_KEY = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/runtime/trafilatura-api-key"
}
replika_runtime_environment = {
  BCE_BASE_URL               = "https://bce-stag.clodexa.com/"
  BCE_TIMEOUT_MS             = "10000"
  BCE_EXTENSION_DOWNLOAD_URL = "https://bce-extension-releases-ACCOUNT.s3.ap-south-1.amazonaws.com/latest.zip"
  BCE_EXTENSION_VERSIONS_URL = "https://bce-extension-releases-ACCOUNT.s3.ap-south-1.amazonaws.com/index.html"
  BROWSER_BACKEND            = "bce"
  BEDROCK_REGION             = "us-east-1"
  TRAFILATURA_ENDPOINT       = "https://web-fetch.example.internal"
}

# Existing shared infrastructure Secrets Manager ARNs, never secret values.
# Tenant-only provider credentials are configured separately above.
secret_arns = {
  MONGO_URI        = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/mongo-uri"
  REDIS_URL        = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/redis-url"
  TOWER_SECRET_KEY = "arn:aws:secretsmanager:ap-south-1:ACCOUNT:secret:replika/session-key"
}

environment = {
  AWS_REGION           = "ap-south-1"
  APPCONFIG_REQUIRED   = "true"
  TOWER_AUTH_REQUIRED  = "true"
  TOWER_AUTH_USERNAME  = "clyra"
  TOWER_COOKIE_SECURE  = "true"
  GALADRIEL_WORKER     = "1"
  GALADRIEL_REFLECTION = "1"
}

# Control-plane-only secret values belong in the staging AppConfig profile;
# tenant provider credentials belong in Secrets Manager. Never put values here.
