# === Required (Gemini default) ===
# Native local runs: set this to keep mutable agent state under
# .galadriel-local/ instead of changing repository defaults. Docker Compose
# sets it automatically.
GALADRIEL_ENV=local

GEMINI_API_KEY=your-gemini-api-key
# Alternative env var name accepted by the Gemini provider:
# GOOGLE_API_KEY=your-gemini-api-key

DISCORD_BOT_TOKEN=your-discord-bot-token

# === Slack (alternative to Discord — see README "Slack" section) ===
# Both must be set to enable the Slack gateway. Only one gateway (Discord or
# Slack) should be configured per deployment.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# === Required only if using Claude or the open models (both run on Bedrock) ===
# Copy entries from BEDROCK_DEFAULTS in harness/model_registry.py into TASKS,
# or just pick a Bedrock model in Tower. One credential covers both Bedrock
# providers. Omit it entirely to run on ambient AWS credentials (EC2/ECS role).
# AWS_BEARER_TOKEN_BEDROCK=
# Region for Bedrock only — separate from AWS_REGION, which other infra uses.
# us-east-1 serves a superset of every other region and is the default. Some
# models work ONLY here (Nemotron 3 Super 120B hangs forever in ap-south-1).
# BEDROCK_REGION=us-east-1

# === Discord Config ===
# Your own Discord user ID (right-click your name → Copy User ID with Developer Mode on)
DISCORD_AUTHORIZED_USER_ID=your-discord-user-id
DISCORD_CHANNEL_ID=your-channel-id

# === Slack Config ===
# Which channel the bot listens in (right-click the channel name in Slack →
# View channel details → Channel ID is at the bottom). Any member of that
# channel can talk to it (mention the bot to get its attention) — no user
# allowlist like Discord's. See the README's "Slack" section for the
# one-time app setup (Socket Mode, scopes, event subscriptions).
SLACK_CHANNEL_ID=your-slack-channel-id
# Manual Socket Mode boundary: organization uses exactly SLACK_CHANNEL_ID;
# individual accepts only DMs from this Slack user (message.im subscription).
REPLIKA_TYPE=organization
SLACK_OWNER_USER_ID=your-slack-user-id
# Comma-separated additional admins for manual Socket Mode. Organization
# members may chat/read, but only owner/installer/admin IDs receive mutating
# tools and may resolve approval buttons.
SLACK_ADMIN_USER_IDS=

# === Central Slack OAuth control plane ===
# Enable the durable control-plane dispatcher only in the control service.
SLACK_DISPATCHER_ENABLED=false
SLACK_CONTROL_PLANE_URL=https://control.example.com
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=https://control.example.com/integrations/slack/oauth/callback
SLACK_OAUTH_STATE_SECRET=
SLACK_TOKEN_SECRET_PREFIX=replika/slack-token
SLACK_TOKEN_KMS_KEY_ID=
SLACK_TENANT_AUTH_SECRET_PREFIX=replika/slack-auth
SLACK_TENANT_AUTH_KMS_KEY_ID=alias/aws/secretsmanager
# Required by the central dispatcher: tenant runtime URLs must be HTTPS and
# equal to, or be subdomains of, this product domain.
SLACK_TENANT_PRODUCT_DOMAIN=example.com
# Explicit local/test-only escape hatch; never enable in production.
SLACK_ALLOW_INSECURE_TENANT_URLS=false

# === Tower UI ===
# SECURITY: Bind to 127.0.0.1 (localhost only) unless you have authentication in front of it.
# The Tower UI has no built-in auth — if bound to 0.0.0.0 on a public server, anyone
# who can reach the port can talk to your agent. Use an SSH tunnel or reverse proxy with auth.
TOWER_HOST=127.0.0.1
TOWER_PORT=8080
# Flask session-signing key. Required (and must not be the default) whenever
# TOWER_AUTH_REQUIRED=true — otherwise session cookies are forgeable.
TOWER_SECRET_KEY=change-me-to-something-random
# Secure cookies (HTTPS only). Defaults to true when TOWER_AUTH_REQUIRED=true;
# set false for local HTTP development against the login form.
# TOWER_COOKIE_SECURE=false

# === ECS / staging ===
# ECS retrieves the approved AppConfig profile through its task-role sidecar.
# Do not commit credentials to a .env file or bake them into the image.
AWS_REGION=ap-south-1
APPCONFIG_REQUIRED=true
APPCONFIG_AGENT_URL=http://127.0.0.1:2772
APPCONFIG_APPLICATION=rjh1ukh
APPCONFIG_ENVIRONMENT=g635nuc
APPCONFIG_CONFIGURATION=swqwh37
TOWER_HOST=0.0.0.0
TOWER_PORT=8080
TOWER_THREADS=8
TOWER_AUTH_REQUIRED=true
TOWER_AUTH_USERNAME=clyra
# Shared password for the /login form and legacy Authorization: Bearer token.
TOWER_AUTH_TOKEN=inject-from-secrets-manager
# Also required in AppConfig when auth is on: a strong TOWER_SECRET_KEY.
TOWER_COOKIE_SECURE=true
GALADRIEL_STORAGE_ROOT=/mnt/efs
GALADRIEL_COMPLETION_MARKER_DIR=/mnt/efs/completion-markers
MEMPALACE_PATH=/data/.mempalace/palace
PALACE_ARCHIVE_ROOT=/data/.mempalace/archive
PALACE_WAKE_UP_FILE=/data/.mempalace/wake_up.md

# === Phone Agent Bridge ===
# Enables the authenticated WSS bridge and localhost-only ADB listener.
PHONE_BRIDGE_ENABLED=1
PHONE_BRIDGE_WS_HOST=0.0.0.0
PHONE_BRIDGE_WS_PORT=8765
PHONE_BRIDGE_TCP_PORT=37000
PHONE_BRIDGE_SESSION_SECONDS=3600
PHONE_BRIDGE_AUTH_STORE=/mnt/efs/state/phone_bridge_auth.json
# Advertise the seven constrained phone_* tools to the agent.
PHONE_TOOLS_ENABLED=1
# Keep arbitrary phone_shell disabled unless an operator explicitly approves it.
PHONE_SHELL_ALLOW_ARBITRARY=0
ADB_VENDOR_KEYS=/data/.android/adbkey

# Browser Command Executor is externally hosted; no local Chrome or
# browser-use installation is needed in the ECS image.
BROWSER_BACKEND=bce
BCE_BASE_URL=https://browser-command-executor.example.internal
BCE_API_KEY=inject-from-secrets-manager
BCE_PAIRING_CODE=inject-from-secrets-manager
BCE_TIMEOUT_MS=10000
# Public Chrome extension zip (Load unpacked).
BCE_EXTENSION_DOWNLOAD_URL=https://bce-extension-releases-020571892795.s3.ap-south-1.amazonaws.com/latest.zip
BCE_EXTENSION_VERSIONS_URL=https://bce-extension-releases-020571892795.s3.ap-south-1.amazonaws.com/index.html

# === AWS (optional - uses task/instance role when hosted on AWS) ===
# AWS_REGION is ap-south-1 for Clyra staging (set above).
# Leave AWS_PROFILE blank when using an EC2 instance role — setting it breaks the AWS CLI
AWS_PROFILE=

# === Web page reading (fetch_url_data waterfall) ===
# Fast, browser-free page extraction. Tried before the browser tool when you
# just need to READ a page. Each extractor is skipped if its key is unset; if
# both are unset, fetch_url_data always returns [no content] and you fall back
# to the browser tool. Order: Trafilatura Lambda first (cheap/fast), then
# Handinger markdown (more robust).
TRAFILATURA_ENDPOINT=
TRAFILATURA_API_KEY=
HANDINGER_API_KEY=

# === Browser (browser-use CLI) ===
# The `browser` tool shells out to the browser-use CLI, which drives a real
# local Chrome over CDP. Install it once on the host:
#   pip install "browser-use[core]" && browser-use install
# We launch ONE dedicated Chrome with a fixed user-data-dir + debug port, so its
# profile (cookies/logins) PERSISTS across sessions and stays isolated from your
# personal Chrome. Every browser-use command is routed to it via --cdp-url.
# Headed mode defaults on so the window is visible and you can take over for
# CAPTCHA / login. Set to 0 to launch the dedicated Chrome headless instead.
BROWSER_USE_HEADED=1
# Where the persistent profile lives (cookies, logins, history).
BROWSER_PROFILE_DIR=~/.galadriel/browser-profile
# CDP debug port for the dedicated Chrome.
BROWSER_CDP_PORT=9222
# Chrome/Chromium executable. Defaults to macOS Google Chrome if unset.
CHROME_BINARY=
# Multiple accounts: the agent or Tower Devices page can register additional
# tenant-scoped profiles in MongoDB, each with its own isolated Chrome + CDP
# port, e.g. to run two LinkedIn logins concurrently.
# This only affects NAMED profiles — the default "main" profile above is
# untouched. Parent directory for named profiles' cookie jars (one subfolder
# per profile); each profile's CDP port is stored in MongoDB.
BROWSER_PROFILES_DIR=~/.galadriel/browser-profiles

# === Google Search (google_search) ===
SERPER_API_KEY=

# === Explorium lead sourcing (explorium_* tools) ===
# Explorium AgentSource REST API key — powers the company/people sourcing +
# enrichment tools (search/match/enrich businesses and prospects, events).
# Without it the explorium_* tools return an error JSON and everything else
# runs normally. Results are cached in MongoDB for 60 days (collections:
# explorium_businesses / explorium_prospects / explorium_events /
# explorium_match_businesses / explorium_match_prospects) to avoid re-billing.
AGENTSOURCE_API_KEY=

# === Contact enrichment (enrich_contact tool) ===
# Email/phone waterfall: FullEnrich first for email (cheapest, verified), Explorium
# contacts first for phone; each falls back to the other. FullEnrich needs this key;
# the Explorium leg reuses AGENTSOURCE_API_KEY above. Composed results are cached in
# MongoDB (contact_enrichment_cache) for 60 days so repeat lookups don't re-bill.
# A missing key just disables that one provider.
FULLENRICH_API_KEY=

# === Operational DB (MongoDB) — system of record for automation ===
# Used via the shared async Mongo driver scripts/lib/db.py (called inline).
# The agent reads/writes operational state here (dedup, status, audit) — the
# precise counterpart to the fuzzy memory palace. See config/DATA.md.
PALACE_BACKEND=chroma
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/galadriel
MONGO_DB=galadriel
# Set PALACE_BACKEND=mongo for ordinary MongoDB (exact cosine + BM25 fallback)
# or PALACE_BACKEND=documentdb for AWS DocumentDB native HNSW when available.
# DocumentDB example: include tls=true, replicaSet=rs0,
# retryWrites=false, and tlsCAFile=/etc/ssl/certs/rds-ca-bundle.pem.
# The task uses this deployed database directly; it does not start MongoDB.

# === Operational cache (AWS ElastiCache Valkey) ===
# Use the deployed TLS endpoint, injected from Secrets Manager when credentials
# are required. The readiness check verifies the external service on /readyz.
REDIS_URL=rediss://user:password@valkey.example.cache.amazonaws.com:6379/0

# === Agent Behavior ===
# Model selection lives in harness/model_registry.py (NOT here). Defaults:
#   agent:      gemini-3.1-pro-preview  — flagship, 1M context, 4096-token cache minimum
#   compaction: gemini-2.5-flash        — cheap summarizer, 1M context, 2048-token cache minimum
#
# To switch to Bedrock, copy from BEDROCK_DEFAULTS in model_registry.py:
#   agent:      claude-opus-4-6         — highest capability, 1M context
#   compaction: claude-haiku-4-5        — cheapest Claude tier
#
# Every selectable model, its price, caps, and intel score live in
# harness/model_catalog.py. Other options worth knowing (edit TASKS directly):
#   claude-sonnet-4-6  — best practical Claude, ~5x cheaper than Opus
#   glm-5              — strongest open model, ~5x cheaper again
#   glm-4.7-flash      — cheapest tool-capable model, good for gates/titles
#   gemma-3-27b        — judge/classifier ONLY; it ignores tool definitions
#
# Gemini pricing (paid tier, verify live): gemini-3.1-pro-preview $2/$12 per MTok input/output;
# gemini-2.5-flash $0.30/$2.50. Cached input is 90% off on both (2.5+ models).
# Claude cached input is also ~90% off. See CACHING.md for cache minimums and cost examples.
#
# Prompt caching is always active. On a warm cache the stable system prompt (SOUL.md,
# MEMORY.md, identity files) is read at ~10% of normal input cost. Use /status in Discord
# to see live token numbers.

# Max output tokens per API call is not configurable here: each model's
# documented ceiling lives in harness.agent.MODEL_CAPS (Gemini 3.x: 65,536,
# Claude 4.6+: 128,000).

# Input-token ceiling that triggers conversation compaction.
# AGENT_COMPACT_THRESHOLD=300000

DAILY_COST_LIMIT_USD=5.00

# === Memory Palace (MemPalace) — all optional ===
# The harness loads mempalace lazily; if it's not installed, palace tools
# return [palace unavailable] and everything else runs normally. To enable:
#   pip install -r requirements.txt  (includes mempalace>=3.3.2,<3.4)
#   cp mempalace.yaml.example mempalace.yaml
#   mempalace init                   (creates ~/.mempalace/)
#   mempalace mine .                 (seeds the palace from your repo)
#
# Palace directory — read by the MemPalace library itself (not the harness).
# See https://github.com/MemPalace/mempalace for the library's own docs.
# MEMPALACE_PATH=~/.mempalace/palace
#
# Where archived conversations + pre-compaction tool_results land before
# being mined into the palace.
# PALACE_ARCHIVE_ROOT=~/.mempalace/archive
#
# Cached wake-up snapshot file — regenerated after each mine.
# PALACE_WAKE_UP_FILE=~/.mempalace/wake_up.md
#
# Set to 0 to disable injection of the wake-up snapshot into the dynamic
# system-prompt block. Recovers a small per-call token overhead if budget
# is tight. Default: 1 (enabled).
# PALACE_WAKE_UP_INJECT=1
#
# Ambient reflection (workday-cadence palace filing + worker audit + brief status
# to the user). Set to 0 to disable it entirely — recommended if your model tier
# is expensive and you don't want extra automated turns. Default: 1 (enabled).
# GALADRIEL_REFLECTION=1
#
# Background worker (the `worker` stream of the same agent, executing the markdown
# job board — jobs/ + state/ — on a 10-min loop while the main stream stays free
# for the user). Opt-in: set to 1 to start the loop. Even when on, the worker
# does nothing until state/worker_control.md is set to `active` and the board has
# work. Default: 0 (disabled). See config/CONTEXT.md §5.
# GALADRIEL_WORKER=0

# === Semantic recalls (Stage-1 proposal) ===
# RECALL_ENCODER: fastembed (default, BAAI/bge-small-en-v1.5) | gemini
#   (models/text-embedding-004, falls back to fastembed if it fails to load).
#   Chunk window/overlap are code constants, not env — see _RECALL_CHUNK_TOKENS.
# RECALL_ENCODER=fastembed
# RECALL_STAGE1_MARGIN: how far the best-matching recall must beat the runner-up
#   before a chunk proposes anything. Absolute cosine cannot separate tool output
#   from intent (unrelated text still scores ~0.7), but the shape of the ranking
#   can: noise is equally close to everything (top1−top2 ~0.02) while real intent
#   picks one recall out (~0.11). Measured on eval/run_stage1_chunking_eval.py —
#   0.05 takes false proposals on no-fire documents from 75 to 1 with no recall
#   loss; 0.10 starts costing real matches. 0 disables the gate.
# RECALL_STAGE1_MARGIN=0.05

# LITELLM_LOCAL_MODEL_COST_MAP: pinned to True in harness/__init__.py. litellm
#   arrives transitively (semantic-router, headroom-ai) and otherwise fetches its
#   price table from raw.githubusercontent.com on first import, with a 5s timeout
#   that lands mid-turn. The bundled backup has the same models. Set to False
#   only if you need same-day pricing for a newly released model.
# LITELLM_LOCAL_MODEL_COST_MAP=True

# === Semantic recalls (Stage-2 verification) ===
# Stage-1 (embed/lexical + per-recall positive floor) proposes; Stage-2 verifies
# via a batched judge-model entailment call. Fail-closed: without GEMINI_API_KEY
# the WHOLE recall system disarms (no scan, no inject), and an
# unreachable/malformed judge rejects that scan's candidates.
#
# RECALL_JUDGE_MODEL: any model from tower_settings.JUDGE_MODEL_OPTIONS; env
#   wins over the Tower setting (/api/recall-judge-model). The default lives
#   in tower_settings.DEFAULT_RECALL_JUDGE_MODEL only — gpt-oss-20b as of the
#   accuracy-vs-cost eval in knowledge/reference/bedrock_providers.md (100%
#   accuracy, p90 1.14s, ~$0.05/1k calls, no fallback retry).
#   Superseded 2026-08-18 measurement on the earlier Gemini-only judge, kept
#   for reference:
#     gemini-2.5-flash-lite  P=0.916 R=0.952 F1=0.933
#     gemini-2.5-flash       P=0.916 R=0.952 F1=0.933  identical verdicts
#   The judge provider is resolved from THIS model, not the agent's.
# RECALL_JUDGE_MODEL=gpt-oss-20b
#
# RECALL_SLM_VERIFY: master Stage-2 on/off switch (name predates the judge).
#   Set to 0 to disable Stage-2 verification entirely (every proposal fires).
# RECALL_SLM_VERIFY=1
# RECALL_STAGE2_MAX_CANDIDATES: how many Stage-1 proposals get verified per pass,
#   best positive first; the rest are rejected unverified as stage2_candidate_cap.
# RECALL_STAGE2_MAX_CANDIDATES=3
# RECALL_CUE_SATURATION: cosine at/above which a new cue from tune_recall is
#   dropped as already covered. Both stages score with max(), so a near-duplicate
#   is dead weight at best.
# RECALL_CUE_SATURATION=0.9
