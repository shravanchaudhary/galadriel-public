# === Required (Gemini default) ===
GEMINI_API_KEY=your-gemini-api-key
# Alternative env var name accepted by the Gemini provider:
# GOOGLE_API_KEY=your-gemini-api-key

DISCORD_BOT_TOKEN=your-discord-bot-token

# === Slack (alternative to Discord — see README "Slack" section) ===
# Both must be set to enable the Slack gateway. Only one gateway (Discord or
# Slack) should be configured per deployment.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# === Required only if switching back to Claude ===
# Copy entries from ANTHROPIC_DEFAULTS in harness/model_registry.py into TASKS,
# then set:
# ANTHROPIC_API_KEY=sk-ant-...

# === Discord Config ===
# Your own Discord user ID (right-click your name → Copy User ID with Developer Mode on)
DISCORD_AUTHORIZED_USER_ID=your-discord-user-id
DISCORD_CHANNEL_ID=your-channel-id

# === Slack Config ===
# Which channel the bot listens in (right-click the channel name in Slack →
# View channel details → Channel ID is at the bottom). Any member of that
# channel can talk to it (mention the bot to get its attention) — no user
# allowlist like Discord's. See the README's "Slack" section for the
# one-time app setup (Socket Mode, scopes, event subscriptions).
SLACK_CHANNEL_ID=your-slack-channel-id

# === Tower UI ===
# SECURITY: Bind to 127.0.0.1 (localhost only) unless you have authentication in front of it.
# The Tower UI has no built-in auth — if bound to 0.0.0.0 on a public server, anyone
# who can reach the port can talk to your agent. Use an SSH tunnel or reverse proxy with auth.
TOWER_HOST=127.0.0.1
TOWER_PORT=8080
# Change this to a long random string in production
TOWER_SECRET_KEY=change-me-to-something-random

# === ECS / staging ===
# ECS retrieves the approved AppConfig profile through its task-role sidecar.
# Do not commit credentials to a .env file or bake them into the image.
AWS_REGION=ap-south-1
APPCONFIG_REQUIRED=true
APPCONFIG_AGENT_URL=http://127.0.0.1:2772
APPCONFIG_APPLICATION=rjh1ukh
APPCONFIG_ENVIRONMENT=g635nuc
APPCONFIG_CONFIGURATION=swqwh37
TOWER_HOST=0.0.0.0
TOWER_PORT=8080
TOWER_THREADS=8
TOWER_AUTH_REQUIRED=true
TOWER_AUTH_USERNAME=clyra
TOWER_AUTH_TOKEN=inject-from-secrets-manager
GALADRIEL_EFS_ROOT=/mnt/efs
GALADRIEL_COMPLETION_MARKER_DIR=/mnt/efs/completion-markers
MEMPALACE_PATH=/data/.mempalace/palace
PALACE_ARCHIVE_ROOT=/data/.mempalace/archive
PALACE_WAKE_UP_FILE=/data/.mempalace/wake_up.md

# Browser Command Executor is externally hosted; no local Chrome or
# browser-use installation is needed in the ECS image.
BROWSER_BACKEND=bce
BCE_BASE_URL=https://browser-command-executor.example.internal
BCE_API_KEY=inject-from-secrets-manager
BCE_PAIRING_CODE=inject-from-secrets-manager
BCE_TIMEOUT_MS=10000

# === AWS (optional - uses task/instance role when hosted on AWS) ===
# AWS_REGION is ap-south-1 for Clyra staging (set above).
# Leave AWS_PROFILE blank when using an EC2 instance role — setting it breaks the AWS CLI
AWS_PROFILE=

# === Web page reading (fetch_url_data waterfall) ===
# Fast, browser-free page extraction. Tried before the browser tool when you
# just need to READ a page. Each extractor is skipped if its key is unset; if
# both are unset, fetch_url_data always returns [no content] and you fall back
# to the browser tool. Order: Trafilatura Lambda first (cheap/fast), then
# Handinger markdown (more robust).
TRAFILATURA_ENDPOINT=
TRAFILATURA_API_KEY=
HANDINGER_API_KEY=

# === Browser (browser-use CLI) ===
# The `browser` tool shells out to the browser-use CLI, which drives a real
# local Chrome over CDP. Install it once on the host:
#   pip install "browser-use[core]" && browser-use install
# We launch ONE dedicated Chrome with a fixed user-data-dir + debug port, so its
# profile (cookies/logins) PERSISTS across sessions and stays isolated from your
# personal Chrome. Every browser-use command is routed to it via --cdp-url.
# Headed mode defaults on so the window is visible and you can take over for
# CAPTCHA / login. Set to 0 to launch the dedicated Chrome headless instead.
BROWSER_USE_HEADED=1
# Where the persistent profile lives (cookies, logins, history).
BROWSER_PROFILE_DIR=~/.galadriel/browser-profile
# CDP debug port for the dedicated Chrome.
BROWSER_CDP_PORT=9222
# Chrome/Chromium executable. Defaults to macOS Google Chrome if unset.
CHROME_BINARY=
# Multiple accounts: the agent can register additional named profiles by
# editing state/browser_profiles.md directly (read_file/write_file, no
# dedicated tool — see its own header for the procedure), each its own
# isolated Chrome + CDP port, e.g. to run two LinkedIn logins concurrently.
# This only affects NAMED profiles — the default "main" profile above is
# untouched. Parent directory for named profiles' cookie jars (one subfolder
# per profile); the CDP port for each is chosen by the agent per-profile and
# recorded in that file.
BROWSER_PROFILES_DIR=~/.galadriel/browser-profiles

# === Google Search (google_search) ===
SERPER_API_KEY=

# === Explorium lead sourcing (explorium_* tools) ===
# Explorium AgentSource REST API key — powers the company/people sourcing +
# enrichment tools (search/match/enrich businesses and prospects, events).
# Without it the explorium_* tools return an error JSON and everything else
# runs normally. Results are cached in MongoDB for 60 days (collections:
# explorium_businesses / explorium_prospects / explorium_events /
# explorium_match_businesses / explorium_match_prospects) to avoid re-billing.
AGENTSOURCE_API_KEY=

# === Contact enrichment (enrich_contact tool) ===
# Email/phone waterfall: FullEnrich first for email (cheapest, verified), Explorium
# contacts first for phone; each falls back to the other. FullEnrich needs this key;
# the Explorium leg reuses AGENTSOURCE_API_KEY above. Composed results are cached in
# MongoDB (contact_enrichment_cache) for 60 days so repeat lookups don't re-bill.
# A missing key just disables that one provider.
FULLENRICH_API_KEY=

# === Operational DB (MongoDB) — system of record for automation ===
# Used via the shared async Mongo driver scripts/lib/db.py (called inline).
# The agent reads/writes operational state here (dedup, status, audit) — the
# precise counterpart to the fuzzy memory palace. See config/DATA.md.
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/galadriel
MONGO_DB=galadriel
# DocumentDB example: include tls=true, replicaSet=rs0,
# retryWrites=false, and tlsCAFile=/etc/ssl/certs/rds-ca-bundle.pem.
# The task uses this deployed database directly; it does not start MongoDB.

# === Operational cache (AWS ElastiCache Valkey) ===
# Use the deployed TLS endpoint, injected from Secrets Manager when credentials
# are required. The readiness check verifies the external service on /readyz.
REDIS_URL=rediss://user:password@valkey.example.cache.amazonaws.com:6379/0

# === Agent Behavior ===
# Model selection lives in harness/model_registry.py (NOT here). Defaults:
#   agent:      gemini-3.1-pro-preview  — flagship, 1M context, 4096-token cache minimum
#   compaction: gemini-2.5-flash        — cheap summarizer, 1M context, 2048-token cache minimum
#
# To switch back to Claude, copy from ANTHROPIC_DEFAULTS in model_registry.py:
#   agent:      claude-opus-4-8         — highest capability, 1M context, 1024-token cache min
#   compaction: claude-haiku-4-5        — cheapest Claude tier, 4096-token cache minimum
#
# Other Claude options (edit TASKS directly):
#   claude-sonnet-4-6  — great balance, 2048-token cache minimum, ~5x cheaper than Opus
#   claude-haiku-4-5   — cheapest Claude, good for automation / always-on agents
#
# Gemini pricing (paid tier, verify live): gemini-3.1-pro-preview $2/$12 per MTok input/output;
# gemini-2.5-flash $0.30/$2.50. Cached input is 90% off on both (2.5+ models).
# Claude cached input is also ~90% off. See CACHING.md for cache minimums and cost examples.
#
# Prompt caching is always active. On a warm cache the stable system prompt (SOUL.md,
# MEMORY.md, identity files) is read at ~10% of normal input cost. Use /status in Discord
# to see live token numbers.

# Max output tokens per API call. 8192 is a good balance:
#   - Low enough to keep per-call output cost reasonable
#   - High enough that the max_tokens retry path rarely triggers
AGENT_MAX_TOKENS=8192

DAILY_COST_LIMIT_USD=5.00

# === Memory Palace (MemPalace) — all optional ===
# The harness loads mempalace lazily; if it's not installed, palace tools
# return [palace unavailable] and everything else runs normally. To enable:
#   pip install -r requirements.txt  (includes mempalace>=3.3.2,<3.4)
#   cp mempalace.yaml.example mempalace.yaml
#   mempalace init                   (creates ~/.mempalace/)
#   mempalace mine .                 (seeds the palace from your repo)
#
# Palace directory — read by the MemPalace library itself (not the harness).
# See https://github.com/MemPalace/mempalace for the library's own docs.
# MEMPALACE_PATH=~/.mempalace/palace
#
# Where archived conversations + pre-compaction tool_results land before
# being mined into the palace.
# PALACE_ARCHIVE_ROOT=~/.mempalace/archive
#
# Cached wake-up snapshot file — regenerated after each mine.
# PALACE_WAKE_UP_FILE=~/.mempalace/wake_up.md
#
# Set to 0 to disable injection of the wake-up snapshot into the dynamic
# system-prompt block. Recovers a small per-call token overhead if budget
# is tight. Default: 1 (enabled).
# PALACE_WAKE_UP_INJECT=1
#
# Ambient reflection (workday-cadence palace filing + worker audit + brief status
# to the user). Set to 0 to disable it entirely — recommended if your model tier
# is expensive and you don't want extra automated turns. Default: 1 (enabled).
# GALADRIEL_REFLECTION=1
#
# Background worker (the second "worker" agent channel that executes the markdown
# job board — jobs/ + state/ — on a 10-min loop while the main channel stays free
# for the user). Opt-in: set to 1 to start the loop. Even when on, the worker
# does nothing until state/worker_control.md is set to `active` and the board has
# work. Default: 0 (disabled). See config/CONTEXT.md §5.
# GALADRIEL_WORKER=0
