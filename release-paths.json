{
  "shared": {
    "includes": [
      "docker/**",
      "release-paths.json",
      "scripts/deploy_replika_fleet.py",
      "phone_bridge/**",
      "tower/auth.py",
      "tower/slack_integration.py",
      "tower/templates/*",
      "tower/static/**"
    ],
    "excludes": []
  },
  "control": {
    "includes": [
      "buildspec-control.yml",
      "Dockerfile.control",
      "control_main.py",
      "requirements-control.txt",
