{
  "workflow": "inbound_engagements",
  "entities": {
    "inbound_comment": {
      "collection": "inbound_comments",
      "key": "comment_id",
      "states": [
        "detected",
        "drafting_reply",
        "review_pending",
        "approved",
        "replied",
        "ignored"
      ],
      "initial": "detected",
      "transitions": {
        "detected": ["drafting_reply", "ignored"],
        "drafting_reply": ["review_pending"],
        "review_pending": ["approved", "drafting_reply", "ignored"],
        "approved": ["replied", "drafting_reply"],
        "ignored": ["drafting_reply"]
      },
      "approval_states": [
        "review_pending"
      ],
      "fields": [
        "post_url",
        "commenter_name",
        "commenter_profile_url",
        "comment_text",
        "reply_draft",
        "intent_evaluation"
      ],
      "table_columns": [
        "commenter_name",
        "status",
        "intent_evaluation"
      ]
    },
    "engagement_lead": {
      "collection": "engagement_leads",
      "key": "lead_id",
      "states": [
        "detected",
        "enriching",
        "qualified",
        "disqualified",
        "handed_off"
      ],
      "initial": "detected",
      "transitions": {
        "detected": ["enriching"],
        "enriching": ["qualified", "disqualified"],
        "qualified": ["handed_off"],
        "disqualified": ["enriching"]
      },
      "approval_states": [],
      "fields": [
        "source_comment_id",
        "prospect_name",
        "linkedin_url",
        "company",
        "intent_reason"
      ],
      "table_columns": [
        "prospect_name",
        "status",
        "company"
      ]
    }
  }
}
