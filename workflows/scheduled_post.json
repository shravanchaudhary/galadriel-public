{
  "workflow": "scheduled_posts",
  "entities": {
    "scheduled_post": {
      "collection": "scheduled_posts",
      "key": "post_id",
      "states": [
        "queued",
        "publishing",
        "published",
        "failed"
      ],
      "initial": "queued",
      "transitions": {
        "queued": ["publishing", "failed"],
        "publishing": ["published", "failed"],
        "failed": ["queued", "publishing"]
      },
      "approval_states": [],
      "fields": [
        "draft_id",
        "author",
        "scheduled_for",
        "content",
        "post_url",
        "error_reason"
      ],
      "table_columns": [
        "post_id",
        "author",
        "scheduled_for",
        "status"
      ]
    }
  }
}
